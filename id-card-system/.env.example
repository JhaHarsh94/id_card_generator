# Development defaults to browser storage. Production always uses the API.
# Set this to api when testing the database-backed application locally.
# VITE_DATA_BACKEND=api

# Server-side PostgreSQL connection. For Neon, use the pooled endpoint.
# Never prefix a database credential with VITE_.
# DATABASE_URL=postgresql://USER:PASSWORD@YOUR-POOLED-HOST/DATABASE?sslmode=require

# Used locally by npm run admin:create. Keep real values in .env.local.
# IDCMS_ADMIN_EMAIL=admin@example.org
# IDCMS_ADMIN_PASSWORD=
# IDCMS_ADMIN_NAME=Administrator
