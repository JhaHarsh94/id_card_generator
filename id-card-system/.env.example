# -----------------------------------------------------------------------------
# Environment variables
#
# Copy this file to `.env` and fill in the values. Vite only exposes variables
# prefixed with VITE_ to the browser bundle.
#
# SECURITY: VITE_SUPABASE_ANON_KEY is the PUBLIC anon key. It is safe to ship in
# frontend code ONLY because every table is protected by Row Level Security (see
# supabase/schema.sql). NEVER put the service_role key here - it bypasses RLS
# and would let anyone read or write the entire database from the browser.
# -----------------------------------------------------------------------------

# Leave these unset to run in local demo mode (data lives in the browser's
# localStorage and auth is a local development fallback). Set them to go live.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=