{
  "name": "id-card-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/check-browser.mjs",
    "test:system": "node scripts/check-system.mjs",
    "dev:test-api": "node scripts/serve-test-api.mjs",
    "check": "npm run lint && npm test && npm run build",
    "preview": "vite preview",
    "db:setup": "node --env-file-if-exists=.env.local scripts/setup-db.mjs",
    "admin:create": "node --env-file-if-exists=.env.local scripts/setup-admin.mjs"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.53.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
